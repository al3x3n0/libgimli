@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(DWARF_PARSER_HAS_Z3 "@DWARF_HAVE_Z3@")

if(DWARF_PARSER_HAS_Z3)
    find_dependency(PkgConfig REQUIRED)
    pkg_check_modules(Z3 REQUIRED IMPORTED_TARGET z3)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/DwarfParserTargets.cmake")

check_required_components(DwarfParser)
